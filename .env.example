# Ducat — environment configuration.
# Local-first works with just the DATABASE_URL default below. The other Session 7
# vars (TURSO_*, AUTH_*, SESSION_SECRET, CRON_SECRET) are for OPTIONAL cloud mode
# only — see DEPLOY.md.

# Local-first (default): a SQLite file on this machine.
# Cloud mode (Session 7): a Turso libSQL URL — libsql://<db>-<org>.turso.io
DATABASE_URL="file:./data/ducat.db"

# Turso auth token — REQUIRED when DATABASE_URL is a libsql:// URL; empty for local.
TURSO_AUTH_TOKEN=""

# --- Auth gate (Session 7) ---
# Leave BOTH empty for local-first (no login wall on localhost). In cloud mode
# (a libsql:// DATABASE_URL) BOTH are REQUIRED or the app refuses to serve.
# Generate them without exposing your password:  npm run auth:set-password
AUTH_PASSWORD_HASH=""
SESSION_SECRET=""

# Daily-sync cron secret (Session 7). Vercel sends this as `Authorization:
# Bearer <CRON_SECRET>` to /api/cron/sync. Use a random string; required for
# the cron to run in cloud mode.
CRON_SECRET=""

# Timezone for DISPLAYED wall-clock instants ("synced Jul 25, 1:04 PM EDT").
# Leave empty locally — your machine's zone is used. Set it in cloud mode, where
# functions run in UTC and sync times would otherwise read hours off. Transaction
# dates and all period math are pinned to UTC in code and unaffected either way.
# DUCAT_TIMEZONE overrides this if a host ignores TZ.
TZ=""

# Opt out of Next.js's anonymous telemetry for THIS deployment. `next telemetry
# disable` only writes a per-machine global, so a fresh clone defaults to ON —
# setting it here keeps the "nothing leaves this machine" guarantee per-repo.
NEXT_TELEMETRY_DISABLED=1

# SimpleFIN access URL — get one via: npm run simplefin:claim -- <setup-token>
# For the public demo feed: https://demo:demo@beta-bridge.simplefin.org/simplefin
SIMPLEFIN_ACCESS_URL=""
