generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum AccountType {
  DEPOSITORY
  CREDIT
  INVESTMENT
  LOAN
}

enum TransactionFlow {
  INFLOW
  OUTFLOW
  TRANSFER
}

enum CategorySource {
  AGGREGATOR
  RULE
  MANUAL
}

enum TransactionSource {
  SIMPLEFIN
  CSV
  PDF
}

enum RuleMatchField {
  MERCHANT
  DESCRIPTION
  AMOUNT
  ACCOUNT
}

enum RuleMatchOperator {
  CONTAINS
  EQUALS
  REGEX
  GT
  LT
}

model Account {
  id            String   @id @default(cuid())
  externalId    String
  connectorType String
  institution   String
  name          String
  type          AccountType
  currency      String
  balance       Decimal
  balanceDate   DateTime
  isStale       Boolean
  createdAt     DateTime @default(now())

  transactions  Transaction[]
  snapshots     BalanceSnapshot[]
  importBatches ImportBatch[]
}

// One statement file an import read: which file, which account and period,
// and how many rows it added. Transaction.importBatchId points here, which is
// what makes "which file produced this row" answerable and an import undoable.
model ImportBatch {
  id          String            @id @default(cuid())
  source      TransactionSource
  fileName    String
  // The file's bytes, hashed: the same statement downloaded twice is one
  // statement whatever it was named, and is refused the second time.
  fileSha256  String
  accountId   String
  account     Account           @relation(fields: [accountId], references: [id])
  periodStart DateTime
  periodEnd   DateTime
  rowsAdded   Int
  importedAt  DateTime          @default(now())

  @@index([accountId])
}

model BalanceSnapshot {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id])
  date      DateTime
  balance   Decimal

  @@unique([accountId, date])
  // Net worth history reads snapshots by date range.
  @@index([date])
}

model Transaction {
  id                 String            @id @default(cuid())
  accountId          String
  account            Account           @relation(fields: [accountId], references: [id])
  externalId         String
  date               DateTime
  amount             Decimal
  description        String
  normalizedMerchant String
  flow               TransactionFlow
  categoryId         String?
  category           Category?         @relation(fields: [categoryId], references: [id])
  categorySource     CategorySource
  transferPairId     String?
  transferPair       Transaction?      @relation("TransferPair", fields: [transferPairId], references: [id])
  transferPairOf     Transaction[]     @relation("TransferPair")
  // Inflow that pays back a specific outflow (dinner fronted, Zelled back):
  // analytics subtract it from the original's category and period.
  reimbursesId       String?
  reimburses         Transaction?      @relation("Reimbursement", fields: [reimbursesId], references: [id])
  reimbursedBy       Transaction[]     @relation("Reimbursement")
  source             TransactionSource
  importedAt         DateTime          @default(now())
  // Trip/project tag ("Tess's March trip"): a cross-period VIEW over real
  // rows, never a re-bucketing — no analyzer reads it. Nullable with no
  // default, deliberately: exactly the shape schema:push can ADD to a
  // populated cloud table.
  groupLabel         String?
  // The ImportBatch (statement file) this row came from; null for every row a
  // feed or CSV wrote. A plain column with no relation, deliberately: a
  // foreign key is a TABLE constraint, which SQLite cannot add to a populated
  // table, where a nullable column is the shape schema:push can ADD.
  importBatchId      String?

  @@unique([accountId, externalId])
  @@index([importBatchId])
  // A foreign key's CHILD column needs an index of its own: deleting a parent
  // makes SQLite look for rows still pointing at it, and without one that look
  // is a scan of the whole table per deleted row. The demo's nightly reset
  // deleted 7,097 transactions, each checked against both self-references by
  // full scan: ~100 million rows READ per reset, and on 2026-10-17 a handful
  // of resets spent the hosting plan's month of reads in a day.
  @@index([transferPairId])
  @@index([reimbursesId])
  @@index([categoryId])
  // Read cost as history grows: the ledger and every period read filter or
  // order by date, and a trip view filters by its label. Without these each is
  // a scan of the whole table (page plans: src/lib/ui/pagePlans.test.ts).
  @@index([date])
  @@index([groupLabel])
}

model Category {
  id       String     @id @default(cuid())
  name     String
  parentId String?
  parent   Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children Category[] @relation("CategoryParent")
  // True income (Salary, Interest): inflows here are earnings — never
  // netted against spending the way categorized reimbursements are.
  isIncome Boolean    @default(false)

  transactions Transaction[]
  rules        Rule[]

  @@index([parentId])
}

model Rule {
  id             String            @id @default(cuid())
  priority       Int
  matchField     RuleMatchField
  matchOperator  RuleMatchOperator
  matchValue     String
  // Optional: a rule may set flow only (e.g. "this payee is a TRANSFER"),
  // which by convention carries no category.
  setCategoryId  String?
  setCategory    Category?         @relation(fields: [setCategoryId], references: [id])
  setFlow        TransactionFlow?
  enabled        Boolean

  @@index([setCategoryId])
}

enum RecurringCadence {
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

model SyncLog {
  id                   String   @id @default(cuid())
  connectorType        String
  startedAt            DateTime
  finishedAt           DateTime
  ok                   Boolean
  errorText            String?
  feedErrors           Json // string[] of non-fatal provider warnings
  accountsSeen         Int
  transactionsImported Int
  transactionsSkipped  Int
  rulesApplied         Int
  transfersLinked      Int

  // Health reads the latest run of a connector.
  @@index([connectorType, finishedAt])
}

model TrackedSubscription {
  id              String           @id @default(cuid())
  name            String
  merchantPattern String // case-insensitive substring matched against merchant/description
  expectedAmount  Decimal
  cadence         RecurringCadence
  anchorDate      DateTime // a known billing date to project the next payment from
  notes           String?
  enabled         Boolean          @default(true)
  createdAt       DateTime         @default(now())
}

model Insight {
  id        String   @id @default(cuid())
  type      String
  period    String
  payload   Json
  dismissed Boolean
  createdAt DateTime @default(now())

  // Every page reads one type or one period; regeneration replaces by period.
  @@index([type, period])
}

model Setting {
  key   String @id
  value String
}

// What this instance spent against its hosts' free-plan limits, counted by the
// app itself (src/lib/usage/meter.ts): Turso's rows read and written as Turso
// reports them per statement, pages served, SimpleFIN requests. Operational,
// not financial data: deliberately outside the backup's TABLES, because every
// page view adds to it and a backup that fingerprints it could never match.
model UsageCount {
  // "2026-10" for a monthly allowance, "2026-10-17" (UTC) for a daily one.
  period String
  metric String
  count  BigInt

  @@id([period, metric])
}
